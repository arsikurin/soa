@startuml
title PostgreSQL · подтверждение по push
hide footbox
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam maxMessageSize 185
skinparam ParticipantPadding 10
skinparam BoxPadding 8
participant "Банк" as bank
participant "API" as api
database "Журнал" as db
participant "Отправитель" as w
participant "Push" as push
participant "Приложение" as app
bank -> api : Событие списания, ключ
api -> db : Уведомление и задание в одной транзакции
db --> api : Запись подтверждена репликой
api --> bank : Номер уведомления
w -> db : Взять задание, сохранить ключ и срок
w -> w : Проверить контакт и разрешение
w -> push : Отправить push с ключом
push --> w : Принято к отправке
w -> db : Записать ответ провайдера
push -> app : Подтверждение списания
app -> api : Квитанция о получении
api -> db : Закрыть доставку, снять таймер
@enduml
