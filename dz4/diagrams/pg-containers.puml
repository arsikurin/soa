@startuml
!include <C4/C4_Container>
title Очередь в PostgreSQL · критичная доставка
Person(customer, "Клиент банка", "Настраивает каналы, получает сообщения")
System_Ext(bank, "Сервисы банка", "Переводы и списания")
System_Ext(profile, "Профиль клиента", "Согласия и проверенные контакты")
System_Ext(gateway, "Каналы доставки", "Push, SMS и email")
System_Boundary(platform, "Платформа уведомлений") {
  Container(api, "API уведомлений", "HTTP", "Принимает события и квитанции")
  ContainerDb(ledger, "Журнал доставки", "PostgreSQL", "Уведомления, попытки, очередь и сроки")
  Container(worker, "Исполнители", "Go", "Забирают готовые задания и отправляют")
}
Rel(bank, api, "Передает событие", "HTTPS")
Rel(api, ledger, "Фиксирует прием и квитанции", "SQL")
Rel(worker, ledger, "Забирает задания, пишет исход", "SQL")
Rel(worker, profile, "Проверяет контакт", "HTTPS")
Rel(worker, gateway, "Отправляет, сверяет статус", "HTTPS")
Rel(gateway, api, "Возвращает квитанции", "HTTPS")
Rel(gateway, customer, "Доставляет сообщение")
Rel(customer, api, "Подтверждает push или email", "HTTPS")
@enduml
